/* 遮罩层 */
.fm-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  animation: fmFadeIn 0.2s ease;
}

/* 弹窗容器 */
.fm-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 320px;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  z-index: 999;
  animation: fmPopIn 0.2s ease;
}

/* 弹窗头部 */
.fm-header {
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fm-title {
  font-size: 17px;
  font-weight: 600;
  color: #333;
}

.fm-close {
  font-size: 20px;
  color: #666;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗主体 */
.fm-body {
  padding: 20px;
}

/* 弹窗底部 */
.fm-footer {
  padding: 12px 20px;
  border-top: 1px solid #eee;
  display: flex;
  gap: 12px;
}

.fm-btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 8px;
  font-size: 15px;
  text-align: center;
}

.fm-btn.cancel {
  background: #fff;
  color: #666;
  border: 1px solid #eee;
}

.fm-btn.confirm {
  background: #FF7A00;
  color: #fff;
}

.fm-btn.confirm:active {
  background: #E86A00;
}

.fm-btn.confirm.disabled {
  background: #ccc;
  pointer-events: none;
}

/* 加载spinner */
.fm-spinner {
  display: inline-block;
  width: 20px;
  height: 20px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: fmSpin 0.6s linear infinite;
  vertical-align: middle;
}

@keyframes fmFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fmPopIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes fmSpin {
  to { transform: rotate(360deg); }
}
