<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{pageLoading}}" class="loading-screen">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
  <view class="head-card">
    <view class="head-left">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" />
    </view>
    <view class="head-center">
      <view class="username">
        {{ isLogin ? userInfo.nickName || userInfo.userName || '用户' : '未登录用户' }}
      </view>
      <view class="sub-text">
        {{ isLogin ? (userInfo.phone ? userInfo.phone : '尚未绑定手机号') : '登录后可接收报警信息' }}
      </view>
    </view>
    <view class="head-right">
      <button
        wx:if="{{!isLogin}}"
        class="login-btn"
        bindtap="goLogin"
      >
        登录
      </button>
      <view wx:else class="login-tag" bindtap="goSetting">已登录 ›</view>
    </view>
  </view>

  <view wx:if="{{isLogin && !hasPhone}}" class="phone-banner" bindtap="goBindPhone">
    <text class="phone-banner-icon">📱</text>
    <view class="phone-banner-text">
      <text>请先绑定手机号以确保报警服务正常使用</text>
      <text class="phone-banner-link">去设置 ›</text>
    </view>
  </view>

  <white-card title="我的设备" customClass="device-card" showRightContent="true">
    <view slot="rightContent" class="add-btn-wrapper">
      <text class="add-btn" bindtap="goBindDevice">＋</text>
    </view>

    <view wx:for="{{devices}}" wx:key="id" class="device-item" bindtap="goDeviceDetail" data-id="{{item.id}}">
      <view class="device-info">
        <view class="device-name">{{item.name}}</view>
      </view>
      <view class="device-status-group">
        <view class="device-status {{item.status}}">{{item.statusText}}</view>
        <view class="device-arrow">›</view>
      </view>
    </view>

    <view wx:if="{{!devices || devices.length === 0}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂未绑定设备</text>
      <text class="empty-hint">点击右上角「＋」添加设备</text>
    </view>
  </white-card>
  </block>
</view>
