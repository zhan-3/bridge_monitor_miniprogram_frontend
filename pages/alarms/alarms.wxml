<view class="page">
  <view class="page-header">
    <view>
      <text class="title">报警记录</text>
      <text class="hint">仅展示已收到的报警，不代表设备实时在线状态</text>
    </view>
    <button class="devices-link" bindtap="goDevices">设备管理</button>
  </view>

  <view wx:if="{{!isLogin}}" class="empty-card">
    <text class="empty-title">登录后查看报警</text>
    <text class="empty-hint">登录并绑定手机号后才能接收报警记录</text>
    <button class="primary-button" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="tabs">
      <view class="tab {{activeStatus === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="selectStatus">待处理</view>
      <view class="tab {{activeStatus === 'handled' ? 'active' : ''}}" data-status="handled" bindtap="selectStatus">已处理</view>
      <view class="tab {{activeStatus === 'all' ? 'active' : ''}}" data-status="all" bindtap="selectStatus">全部</view>
    </view>

    <view wx:if="{{loadError}}" class="empty-card">
      <text class="empty-title">报警列表加载失败</text>
      <button class="primary-button" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:elif="{{!loading && alarms.length === 0}}" class="empty-card">
      <text class="empty-title">暂无{{activeStatus === 'pending' ? '待处理' : ''}}报警</text>
      <text class="empty-hint">设备是触发式通信，待机时不会持续上报状态</text>
    </view>

    <view wx:else class="alarm-list">
      <view wx:for="{{alarms}}" wx:key="alarmId" class="alarm-card">
        <view class="alarm-topline">
          <text class="device-name">设备 {{item.deviceSn}}</text>
          <text class="alarm-status {{item.status}}">{{item.status === 'handled' ? '已处理' : '待处理'}}</text>
        </view>
        <text class="alarm-time">{{item.displayTime}}</text>
        <view class="alarm-meta">
          <text wx:if="{{item.gpsLat !== null && item.gpsLng !== null}}">位置已上报</text>
          <text wx:else>未提供报警位置</text>
          <text wx:if="{{item.fileId}}"> · 有录音</text>
        </view>
        <button wx:if="{{item.status === 'pending'}}" class="handle-button" data-id="{{item.alarmId}}" bindtap="handleAlarm">标记已处理</button>
        <text wx:elif="{{item.displayHandledAt}}" class="handled-time">处理时间：{{item.displayHandledAt}}</text>
      </view>
      <view wx:if="{{loading}}" class="loading-text">加载中...</view>
      <view wx:elif="{{hasMore}}" class="more-button" bindtap="loadMore">加载更多</view>
    </view>
  </block>
</view>
